rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the user themselves can read/write
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Calendars: members only
    match /calendars/{calendarId} {
      allow read: if request.auth != null
                   && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.createdBy == request.auth.uid;

      // Any member can update (add members via join)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;

      // Only creator can delete
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;

      // Events subcollection
      match /events/{eventId} {
        allow read: if request.auth != null
                     && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calendarId)).data.members;

        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calendarId)).data.members
                      && request.resource.data.createdBy == request.auth.uid;

        // Any member can edit
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calendarId)).data.members;

        // Only creator can delete
        allow delete: if request.auth != null
                      && resource.data.createdBy == request.auth.uid;
      }
    }

    // Timetables: owner can read/write
    match /timetables/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
