rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the user themselves can read/write
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Calendars: members only
    match /calendars/{calendarId} {
      allow read: if request.auth != null
                   && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.createdBy == request.auth.uid;

      // Any member can update (add members via join)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members;

      // Only creator can delete
      allow delete: if request.auth != null
                    && resource.data.createdBy == request.auth.uid;

      // Events subcollection — members フィールドで直接判定（get() 不要）
      match /events/{eventId} {
        allow read: if request.auth != null
                     && request.auth.uid in resource.data.members;

        allow create: if request.auth != null
                      && request.auth.uid in request.resource.data.members
                      && request.resource.data.createdBy == request.auth.uid;

        // Any member can edit
        allow update: if request.auth != null
                      && request.auth.uid in resource.data.members;

        // Only creator can delete
        allow delete: if request.auth != null
                      && resource.data.createdBy == request.auth.uid;
      }

      // Polls subcollection (引き続きカレンダーの members で判定)
      match /polls/{pollId} {
        allow read, write: if request.auth != null
                            && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calendarId)).data.members;

        match /votes/{voteId} {
          allow read, write: if request.auth != null
                              && request.auth.uid in get(/databases/$(database)/documents/calendars/$(calendarId)).data.members;
        }
      }
    }

    // Timetables: owner can read/write
    match /timetables/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Tasks: owner can read/write
    match /tasks/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Study records: owner can read/write
    match /study/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
